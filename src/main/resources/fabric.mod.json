{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Recolours your Hypixel SkyBlock level prefix every 20 levels instead of 40, in Hypixel's own palette, with 13 new shades above 480. Every lucky drop, across 64 sources, spins a slot machine that lands on the loot you actually got.",
  "authors": [
    "evansuckedatlife"
  ],
  "contact": {
    "homepage": "https://github.com/evansuckedatlife/SkyPrism",
    "sources": "https://github.com/evansuckedatlife/SkyPrism",
    "issues": "https://github.com/evansuckedatlife/SkyPrism/issues"
  },
  "license": "MIT",
  "icon": "assets/skyprism/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.skyprism.SkyPrismClient"
    ],
    "modmenu": [
      "com.skyprism.mc.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "skyprism.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~${minecraft}",
    "java": ">=25"
  },
  "recommends": {
    "yet_another_config_lib_v3": ">=3.9.5"
  },
  "suggests": {
    "modmenu": "*"
  }
}
